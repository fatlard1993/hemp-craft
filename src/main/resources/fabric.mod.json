{
  "schemaVersion": 1,
  "id": "hemp-craft-justfatlard",
  "version": "${version}",
  "name": "Hemp Craft",
  "description": "Hemp you grow, shape and breed: let a clump run lanky for fibre and seed, or raise one by light and dark into a branching indica, sativa or hybrid and take its flowers.",
  "authors": [
    "justfatlard"
  ],
  "contact": {
    "sources": "https://github.com/fatlard1993/hemp-craft"
  },
  "license": "MIT",
  "icon": "assets/hemp-craft-justfatlard/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "justfatlard.hemp_craft.Main"
    ]
  },
  "depends": {
    "fabricloader": ">=${loaderVersion}",
    "fabric-api": "${fabricApiVersion}",
    "minecraft": "${minecraftDependency}",
    "java": ">=25",
    "pandorical": ">=15.0.0"
  },
  "suggests": {
    "block-tip": "*",
    "useful-hoe": "*"
  },
  "breaks": {
    "block-tip": "<1.1.0"
  }
