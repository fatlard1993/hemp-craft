{
  "schemaVersion": 1,
  "id": "hemp-craft-justfatlard",
  "version": "${version}",
  "name": "Hemp Craft",
  "description": "Hemp you grow, shape and breed: thin a clump of seedlings to one keeper, raise it by light and dark into an indica, sativa or hybrid, and harvest fibre for string and paper and seed from its flowers.",
  "authors": [
    "justfatlard"
  ],
  "contact": {
    "sources": "https://github.com/fatlard1993/hemp-craft"
  },
  "license": "MIT",
  "icon": "assets/hemp-craft-justfatlard/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "justfatlard.hemp_craft.Main"
    ]
  },
  "depends": {
    "fabricloader": ">=${loaderVersion}",
    "fabric-api": "${fabricApiVersion}",
    "minecraft": "${minecraftDependency}",
    "java": ">=25",
    "pandorical": ">=1.3.9"
  },
  "suggests": {
    "block-tip": "*"
  }
}
