{
  "schemaVersion": 1,
  "id": "hemp-craft-justfatlard",
  "version": "${version}",
  "name": "Hemp Craft",
  "description": "Hemp to grow, shape and breed, for fibre, seed and more",
  "authors": [
    "justfatlard"
  ],
  "contact": {
    "sources": "https://github.com/fatlard1993/hemp-craft"
  },
  "license": "MIT",
  "icon": "assets/hemp-craft-justfatlard/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "justfatlard.hemp_craft.Main"
    ]
  },
  "depends": {
    "fabricloader": ">=${loaderVersion}",
